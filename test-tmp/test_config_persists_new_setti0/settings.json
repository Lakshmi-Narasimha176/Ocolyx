{
  "blink_threshold_seconds": 6,
  "blink_rate_threshold_bpm": 14,
  "monitor_interval_seconds": 1,
  "alert_delay_minutes": 0.5,
  "dim_delay_minutes": 5,
  "subsequent_dim_cooldown_minutes": 20,
  "ear_threshold": 0.23,
  "consecutive_frame_count": 3,
  "theme": {
    "mode": "dark",
    "accent_color": "blue"
  },
  "alert_enabled": true,
  "alert_popup_enabled": true,
  "escalation_delay_seconds": 30,
